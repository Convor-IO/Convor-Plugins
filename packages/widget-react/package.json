{
  "name": "@convor/widget-react",
  "version": "0.1.0",
  "description": "React wrapper for the Convor live-chat widget.",
  "keywords": [
    "convor",
    "live-chat",
    "widget",
    "chat",
    "react",
    "react-component"
  ],
  "homepage": "https://convor.io",
  "bugs": {
    "url": "https://github.com/Convor-IO/Convor-Plugins/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Convor-IO/Convor-Plugins.git",
    "directory": "packages/widget-react"
  },
  "license": "MIT",
  "author": "Convor",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "lint": "biome check .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@convor/widget-sdk": "workspace:*",
    "@testing-library/react": "16.3.2",
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "happy-dom": "20.10.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "vite": "^7.3.6",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "@convor/widget-sdk": "*",
    "react": ">=18",
    "react-dom": ">=18"
  }
}
