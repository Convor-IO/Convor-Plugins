{
  "name": "@convor/widget-react",
  "version": "0.1.0",
  "description": "React wrapper for the Convor live-chat widget.",
  "license": "MIT",
  "author": "Convor",
  "homepage": "https://convor.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/Convor-IO/Convor-Plugins.git",
    "directory": "packages/widget-react"
  },
  "bugs": {
    "url": "https://github.com/Convor-IO/Convor-Plugins/issues"
  },
  "keywords": [
    "convor",
    "live-chat",
    "widget",
    "chat",
    "react",
    "react-component"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@convor/widget-sdk": "*",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@convor/widget-sdk": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^21.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
