{
  "name": "@convor/widget-sdk",
  "version": "0.1.0",
  "description": "Framework-agnostic TypeScript SDK for embedding the Convor live-chat widget.",
  "license": "MIT",
  "author": "Convor",
  "homepage": "https://convor.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/Convor-IO/Convor-Plugins.git",
    "directory": "packages/widget-sdk"
  },
  "bugs": {
    "url": "https://github.com/Convor-IO/Convor-Plugins/issues"
  },
  "keywords": [
    "convor",
    "live-chat",
    "widget",
    "chat",
    "sdk"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@types/node": "^26.1.0",
    "happy-dom": "^15.11.0",
    "tsup": "^8.3.5",
    "typescript": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
