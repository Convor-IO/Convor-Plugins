# Copy this file to .env and fill in the values.
# In development, `shopify app dev` writes most of these for you into
# shopify/.env after you link a dev store; these are the raw values the Remix
# server needs.

# Shopify app credentials (from the Partners dashboard).
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Public HTTPS URL of the running app. In dev this is the tunnel URL that
# `shopify app dev` provisions (Cloudflare Tunnel by default).
SHOPIFY_APP_URL=https://convor.ngrok.io

# OAuth scopes. Must match shopify.app.toml's [access_scopes].scopes.
# Must match shopify.app.toml's [access_scopes].scopes.
SCOPES=read_products,write_products

# Optional: if your dev shop is on a custom domain (e.g. for Plus), set it
# here so the OAuth allow-list picks it up.
# SHOP_CUSTOM_DOMAIN=shop.example.com
