{
  "name": "convor-shopify",
  "private": true,
  "description": "Convor live-chat widget for Shopify — Theme App Extension + embedded settings app.",
  "license": "MIT",
  "type": "module",
  "workspaces": {
    "packages": ["extensions/*"]
  },
  "scripts": {
    "build": "remix vite:build",
    "dev": "shopify app dev",
    "format": "biome format --write .",
    "lint": "biome check .",
    "prisma": "prisma",
    "setup": "prisma generate && prisma migrate deploy",
    "shopify": "shopify",
    "start": "remix-serve ./build/server/index.js",
    "typecheck": "tsc --noEmit",
    "vite": "vite"
  },
  "resolutions": {
    "@graphql-codegen/client-preset": "4.7.0",
    "@graphql-codegen/typescript-operations": "4.5.0",
    "@graphql-tools/url-loader": "8.0.16",
    "minimatch": "9.0.5",
    "vite": "^6.2.2"
  },
  "overrides": {
    "@graphql-codegen/client-preset": "4.7.0",
    "@graphql-codegen/typescript-operations": "4.5.0",
    "@graphql-tools/url-loader": "8.0.16",
    "minimatch": "9.0.5",
    "vite": "^6.2.2"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "@remix-run/dev": "^2.16.1",
    "@remix-run/node": "^2.16.1",
    "@remix-run/react": "^2.16.1",
    "@remix-run/serve": "^2.16.1",
    "@shopify/app-bridge-react": "^4.1.6",
    "@shopify/polaris": "^12.0.0",
    "@shopify/shopify-app-remix": "^4.1.0",
    "@shopify/shopify-app-session-storage-prisma": "^9.0.1",
    "isbot": "^5.1.0",
    "prisma": "^6.2.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "remix": "^2.16.1",
    "vite-tsconfig-paths": "^5.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@remix-run/route-config": "^2.16.1",
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "typescript": "6.0.3",
    "vite": "^6.2.2"
  },
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.12 <23"
  },
  "trustedDependencies": ["@shopify/plugin-cloudflare"]
}
