{
  "name": "convor-ecwid",
  "version": "0.1.0",
  "private": true,
  "description": "Convor live-chat widget for Ecwid — storefront customization app + embedded settings.",
  "license": "MIT",
  "type": "module",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "format": "biome format --write .",
    "lint": "biome check .",
    "start": "node dist/src/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "fastify": "^5.2.1",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@types/node": "22.20.1",
    "@types/pg": "^8.20.0",
    "tsx": "4.23.0",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.12 <23"
  }
}
