# Ecwid OAuth credentials — from your registered app in the Ecwid developer program
ECWID_CLIENT_ID=your_app_id
ECWID_CLIENT_SECRET=your_secret_key

# Public URL of THIS app. Must match the redirect URI registered with Ecwid.
# Example: https://convor-ecwid.example.com
ECWID_REDIRECT_URL=https://convor-ecwid.example.com/install

# The appId issued by Ecwid when you registered the app. Used by the storefront
# loader to read public app config via Ecwid.getAppPublicConfig().
ECWID_APP_ID=your_app_id

# HTTPS URL of the storefront loader JS that Ecwid injects on every storefront
# page (see README — registered with Ecwid support). Defaults to a path under
# ECWID_REDIRECT_URL when unset.
# CONVOR_STOREFRONT_JS=https://convor-ecwid.example.com/storefront.js

# Default Convor widget API base (where widget.js is served from)
CONVOR_DEFAULT_API_BASE=https://cdn.convor.io

# Port the Fastify server listens on
PORT=3000
