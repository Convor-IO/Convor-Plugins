# Convor for Wix — environment variables.
#
# These are used by the Wix app's backend (Velo web modules) when it talks to
# the Wix REST API to embed/clear the script. Copy this file to `.env` and fill
# in the values from your Wix Developers workspace
# (https://dev.wix.com → your app → OAuth & API).
#
# DO NOT commit `.env`.

# The OAuth app id of your Wix app (a GUID). Printed on the app's "Headless" or
# "OAuth" page in the Wix Developers workspace.
WIX_APP_ID=

# The API secret for your Wix app. Used to mint the elevated access token the
# backend needs to call the Embedded Scripts API on the merchant's behalf.
WIX_APP_SECRET=

# Optional: override the Convor CDN base. Defaults to https://cdn.convor.io.
# Leave blank in production.
CONVOR_API_BASE=
