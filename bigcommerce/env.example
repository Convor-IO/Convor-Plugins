# Copy this file to .env and fill in the values from your BigCommerce
# Developer Portal app (https://devtools.bigcommerce.com → My Apps).

# OAuth client credentials.
BC_CLIENT_ID=
BC_CLIENT_SECRET=

# Public HTTPS URL of the running app. This must match the Auth Callback URL
# and Load Callback URL configured in the Dev Portal, exactly.
# In dev, point this at your tunnel (Cloudflare Tunnel / ngrok), e.g.
#   https://convor.example.trycloudflare.com
APP_BASE_URL=https://convor.bigcommerce.example.com

# Optional: override the Convor widget CDN. Defaults to https://cdn.convor.io.
# Only set this if Convor support gave you a dedicated region.
# CONVOR_DEFAULT_API_BASE=https://cdn.convor.io

# Postgres database for marketplace-safe install token persistence.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/convor_plugins

# Local port the Fastify server listens on.
PORT=3000
