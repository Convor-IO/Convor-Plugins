{
  "name": "convor-bigcommerce",
  "private": true,
  "description": "Convor live-chat widget for BigCommerce — Scripts API injection + embedded control-panel settings app.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "format": "biome format --write .",
    "lint": "biome check .",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "dotenv": "^17.4.2",
    "fastify": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "22.20.1",
    "@types/pg": "^8.20.0",
    "tsx": "4.23.0",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.12 <23"
  }
}
