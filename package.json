{
  "name": "convor-plugins",
  "version": "0.0.0",
  "private": true,
  "description": "Installable plugins and SDKs for the Convor live-chat widget.",
  "license": "MIT",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r --filter='./packages/*' build",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r --filter='./packages/*' typecheck",
    "test": "pnpm -r --filter='./packages/*' test && node integration-tests/run-all.js",
    "test:e2e": "playwright test --config integration-tests/playwright.config.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@playwright/test": "^1.60.0",
    "typescript": "^5.7.0"
  }
}
