{
  "manifest_version": 3,
  "name": "Convor Live Chat",
  "version": "1.0.0",
  "description": "Inject the Convor live-chat widget into any page you're viewing. For sites that can't add the embed snippet.",
  "minimum_chrome_version": "110",

  "permissions": ["storage", "activeTab", "scripting", "permissions"],

  "host_permissions": [],
  "optional_host_permissions": ["http://*/*", "https://*/*"],

  "background": {
    "service_worker": "dist/background.js"
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "Convor Live Chat",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },

  "options_page": "options.html",

  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "convor@convor.io",
      "strict_min_version": "115.0"
    }
  }
}
