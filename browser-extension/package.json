{
  "name": "@convor/browser-extension",
  "version": "1.0.0",
  "private": true,
  "description": "Browser extension that injects the Convor live-chat widget into any page. Chrome MV3 + Firefox.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "format": "biome format --write .",
    "icons": "python3 scripts/generate-icons.py",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@types/chrome": "^0.0.287",
    "@types/webextension-polyfill": "^0.12.1",
    "tsup": "8.5.1",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.12 <23"
  }
}
