{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <button type="submit" form="form-convor" data-bs-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa-solid fa-save"></i></button>
        <a href="{{ back }}" data-bs-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-light"><i class="fa-solid fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>
  <div class="container-fluid">
    <div class="card">
      <div class="card-header"><i class="fa-solid fa-pencil"></i> {{ text_edit }}</div>
      <div class="card-body">
        <form id="form-convor" action="{{ action }}" method="post" data-oc-toggle="ajax">
          <div class="row mb-3">
            <label class="col-sm-2 col-form-label">{{ entry_status }}</label>
            <div class="col-sm-10">
              <div class="form-check form-switch form-switch-lg">
                <input type="hidden" name="module_convor_widget_status" value="0"/>
                <input type="checkbox" name="module_convor_widget_status" value="1" id="input-status" class="form-check-input"{% if module_convor_widget_status %} checked{% endif %}/>
              </div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-org-slug" class="col-sm-2 col-form-label">{{ entry_org_slug }}</label>
            <div class="col-sm-10">
              <input type="text" name="module_convor_widget_org_slug" value="{{ module_convor_widget_org_slug }}" placeholder="{{ entry_org_slug }}" id="input-org-slug" class="form-control"/>
              <div class="form-text">{{ entry_org_slug_help }}</div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-api-base" class="col-sm-2 col-form-label">{{ entry_api_base }}</label>
            <div class="col-sm-10">
              <input type="text" name="module_convor_widget_api_base" value="{{ module_convor_widget_api_base }}" placeholder="https://cdn.convor.io" id="input-api-base" class="form-control"/>
              <div class="form-text">{{ entry_api_base_help }}</div>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
{{ footer }}
